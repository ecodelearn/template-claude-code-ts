{
  "name": "@ecodelearn/agent-harness",
  "version": "1.0.0",
  "private": true,
  "license": "WTFPL",
  "description": "Universal adopter CLI for code assistant templates.",
  "type": "commonjs",
  "files": [
    "dist/",
    "docs/universal-adopt.md",
    "LICENSE"
  ],
  "bin": {
    "agent-harness": "dist/adopt.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1",
    "start": "node dist/adopt.js",
    "adopt": "npm run build && node dist/adopt.js",
    "adopt:win": "powershell -ExecutionPolicy Bypass -File ./adopt.ps1",
    "test:smoke:gemini": "bash ./scripts/smoke-antigravity.sh gemini",
    "test:smoke:antigravity": "bash ./scripts/smoke-antigravity.sh antigravity"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecodelearn/template-claude-code-ts.git"
  }
}
